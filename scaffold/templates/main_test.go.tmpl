func TestUpdateCheckJSON(t *testing.T) {
	res := testutil.Run(newApp(), "update", "--check", "--json")
	if res.Exit != rungrad.ExitSuccess {
		t.Fatalf("update --check --json exit %d: %s", res.Exit, res.Stderr)
	}
	// The fixed fetcher reports the current version, making update checks
	// deterministic and offline for the generated project.
	var result struct {
		Current   string `json:"current"`
		Available bool   `json:"available"`
		Status    string `json:"status"`
	}
	testutil.AssertStableJSON(t, res.Stdout, &result)
	if result.Current != version {
		t.Fatalf("update current = %q, want generated version %q", result.Current, version)
	}
	if result.Available {
		t.Fatalf("offline starter reported an available update: %+v", result)
	}
	if result.Status != "up_to_date" {
		t.Fatalf("update status = %q, want up_to_date", result.Status)
	}
}
